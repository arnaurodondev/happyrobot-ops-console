    "smoke:auth": "node scripts/smoke-auth.mjs"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
