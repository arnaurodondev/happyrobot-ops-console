# ---------------------------------------------------------------------------
# Carrier Sales Ops Console — environment
#
# LOCAL: copy to `.env.local` (gitignored) and fill in.
# DEPLOYED: set the same keys in the App's "Environment variables" panel.
#           They are server-only there by design: HappyRobot rejects user
#           variables prefixed NEXT_PUBLIC_, which is exactly the posture we
#           want — none of these values may ever reach the browser.
# ---------------------------------------------------------------------------

# --- Twin access (server-side only) ----------------------------------------
# The console reads Twin through POST /api/v2/twin/sql on the platform API,
# NOT through the Twin gateway: the gateway authenticates on a bare x-org-id
# header whose value is in the client bundle, and it cannot do joins or
# aggregates. Every screen here is a join or an aggregate.
#
# Platform-managed on a deployed App; set it locally.
HR_PLATFORM_URL=https://platform.happyrobot.ai

# Org-scoped HappyRobot API key (sk_live_...). SERVER ONLY. Never NEXT_PUBLIC_*.
TWIN_API_KEY=

# --- Console authentication ------------------------------------------------
# A shared credential scoped to the review window. NOT SSO — see the README.
# The console refuses to serve any data if OPS_CONSOLE_PASSWORD is unset; it
# does not fall back to open access.
OPS_CONSOLE_USER=ops
OPS_CONSOLE_PASSWORD=

# HMAC key for the signed session cookie. Optional: if unset, it is derived
# from OPS_CONSOLE_PASSWORD. Set it explicitly in production, >= 16 chars.
OPS_SESSION_SECRET=
